<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only the shared group: the extension reads the push keys and nothing else. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)net.amiantos.Lurker.shared</string>
	</array>
</dict>
</plist>
